}

.container {
  width: min(
    calc(100% - (2 * var(--page-padding))),
    var(--container-width)
  );
  margin-inline: auto;
}

.section {
  position: relative;
  padding-block: var(--section-spacing);
  scroll-margin-top: var(--navbar-height);
}

.eyebrow {
  display: inline-block;
  color: var(--color-primary);
  font-family: var(--font-mono);
  font-size: 0.72rem;
