<file path="src/App.css">
/* =====================================================
   1. GLOBAL STYLES AND THEME
===================================================== */

:root {
  --bg: #321C1D;
  --bg-coffee: #493027;
  --surface: rgba(255, 255, 255, 0.025);
  --surface-hover: rgba(255, 255, 255, 0.055);
  --text-heading: #F0E2CF;
  --text-body: #D8C7B4;
  --text-muted: #BDA58F;
  --accent: #D0A16D;
  --accent-deep: #B47750;
  --border: rgba(233, 217, 196, 0.15);
  --border-hover: rgba(208, 161, 109, 0.5);
}

* {
  box-sizing: border-box;
  min-width: 0;
}

html {
  min-height: 100%;
  scroll-behavior: smooth;
  background: var(--bg);
}

body {
  min-height: 100vh;
  margin: 0;
  background:
    radial-gradient(ellipse at 12% 8%, rgba(155, 91, 59, 0.23), transparent 38%),
    radial-gradient(ellipse at 88% 30%, rgba(116, 54, 51, 0.2), transparent 42%),
    radial-gradient(ellipse at 48% 85%, rgba(105, 68, 43, 0.18), transparent 46%),
    var(--bg);
  background-attachment: fixed;
  color: var(--text-body);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.7;
  letter-spacing: 0.01em;
}

#root {
  width: 100%;
  min-height: 100vh;
  overflow-x: clip;
  background: transparent;
}

.app {
  min-height: 100vh;
  width: 100%;
  overflow-x: clip;
  background: transparent;
}

.container {
  width: min(calc(100% - 2 * var(--page-padding)), var(--container-width));
  margin-inline: auto;
}

.section {
  position: relative;
  width: 100%;
  max-width: 100%;
  padding-block: clamp(48px, 5vw, 72px);
  scroll-margin-top: 24px;
  background: transparent;
}

h1,
h2,
h3,
h4,
h5 {
  color: var(--text-heading);
  font-family: var(--font-heading);
  line-height: 1.25;
  letter-spacing: -0.02em;
}

p {
  color: var(--text-body);
  line-height: 1.8;
  overflow-wrap: anywhere;
}

a {
  color: inherit;
  text-decoration: none;
}

.eyebrow {
  display: inline-block;
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  line-height: 1.6;
  text-transform: uppercase;
}

.accent-text {
  color: var(--accent);
}

.section-heading {
  margin-bottom: 34px;
}

.section-heading h2,
.section-title {
  margin: 8px 0 0;
  color: var(--text-heading);
  font-family: var(--font-heading);
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.025em;
}

.section-description {
  max-width: 620px;
  margin: 12px 0 0;
  color: var(--text-body);
  font-size: 0.98rem;
  line-height: 1.8;
}

/* =====================================================
   2. NAVBAR
===================================================== */

.navbar {
  position: relative;
  z-index: 20;
  width: 100%;
  background: rgba(42, 23, 24, 0.78);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(14px);
}

.navbar-inner {
  width: min(calc(100% - 2 * var(--page-padding)), var(--container-width));
  min-height: var(--navbar-height);
  margin-inline: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.navbar-logo {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  color: var(--text-heading);
  font-family: var(--font-heading);
  font-size: 1.15rem;
  font-weight: 600;
  white-space: nowrap;
}

.logo-mark {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  border-radius: 50%;
  background: var(--accent-deep);
  color: #241817;
  font-family: var(--font-body);
  font-size: 0.82rem;
  font-weight: 700;
}

.nav-links {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: clamp(12px, 1.7vw, 23px);
}

.nav-links a {
  color: var(--text-body);
  font-size: 0.82rem;
  font-weight: 600;
  transition: color 0.2s ease;
}

.nav-links a:hover {
  color: var(--accent);
}

.nav-links .nav-contact {
  padding: 8px 14px;
  border: 1px solid rgba(208, 161, 109, 0.55);
  border-radius: 5px;
  color: var(--accent);
}

.nav-links .nav-contact:hover {
  background: var(--accent-deep);
  color: #241817;
}

.mobile-menu-button {
  display: none;
  color: var(--text-heading);
  background: transparent;
  border: 0;
  cursor: pointer;
  font-size: 1.5rem;
}

/* =====================================================
   3. HERO
===================================================== */

.hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: min(760px, calc(100svh - var(--navbar-height)));
  padding: 65px 0 75px;
  overflow: clip;
  background: transparent;
}

.hero-background {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  width: 440px;
  height: 440px;
  top: 8%;
  right: 5%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(181, 138, 85, 0.12), transparent 70%);
  filter: blur(14px);
}

.hero-content {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.92fr);
  align-items: center;
  gap: clamp(35px, 5vw, 70px);
  width: min(calc(100% - 2 * var(--page-padding)), var(--container-width));
  margin-inline: auto;
}

.hero-text {
  width: 100%;
  max-width: 620px;
}

.hero-eyebrow {
  margin-bottom: 24px;
}

.hero-greeting {
  margin-bottom: 8px;
  color: var(--text-muted);
  font-size: 1rem;
}

.hero h1 {
  max-width: 100%;
  color: var(--text-heading);
  font-family: var(--font-heading);
  font-size: clamp(3.5rem, 6.3vw, 5.7rem);
  font-weight: 600;
  line-height: 1.04;
  letter-spacing: -0.045em;
  overflow-wrap: normal;
}

.hero h1 span {
  color: var(--accent);
}

.hero h2 {
  margin-top: 20px;
  color: var(--accent);
  font-family: var(--font-body);
  font-size: clamp(1rem, 1.6vw, 1.23rem);
  font-weight: 600;
  line-height: 1.5;
}

.hero-separator {
  padding-inline: 4px;
  color: var(--accent);
}

.hero-description {
  max-width: 550px;
  margin-top: 18px;
  color: var(--text-body);
  font-size: 0.98rem;
  line-height: 1.85;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.hero-actions a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
}

.hero-socials {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 19px;
  margin-top: 30px;
  color: var(--text-muted);
  font-size: 0.85rem;
}

.hero-socials a {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--text-muted);
  transition: color 0.2s ease;
}

.hero-socials a:hover {
  color: var(--accent);
}

.hero-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  overflow: visible;
}

.hero-portrait-wrap {
  position: relative;
  width: clamp(300px, 36vw, 430px);
  aspect-ratio: 1;
  flex-shrink: 0;
  margin-inline: auto;
  overflow: hidden;
  border: none;
  border-radius: 50%;
  background: #D4BE9D;
  box-shadow: 0 12px 28px rgba(15, 8, 7, 0.2);
  isolation: isolate;
  transition: transform 0.35s ease;
}

.hero-portrait-wrap::before,
.hero-portrait-wrap::after {
  display: none;
  content: none;
}

.portrait-halo,
.portrait-orbit,
.portrait-placeholder {
  display: none !important;
}

.hero-portrait-wrap:hover {
  transform: translateY(-4px);
}

.portrait-image {
  position: absolute !important;
  left: 50% !important;
  bottom: -8% !important;
  top: auto !important;
  display: block !important;
  width: 120% !important;
  height: 120% !important;
  max-height: none;
  object-fit: contain;
  object-position: center bottom;
  border: 0;
  border-radius: 0;
  background: transparent;
  z-index: 1;
  transform: translateX(-50%);
  filter: none;
  animation: portrait-arrive 0.9s ease both;
}

@keyframes portrait-arrive {
  from {
    opacity: 0;
    transform: translate(-50%, 18px);
  }
  to {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

.hero-scroll {
  position: absolute;
  left: var(--page-padding);
  bottom: 22px;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
}

/* =====================================================
   4. ABOUT
===================================================== */

.about-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(250px, 0.85fr);
  align-items: start;
  gap: clamp(25px, 4vw, 50px);
}

.about-content {
  max-width: 680px;
}

.about-content p {
  margin: 0 0 17px;
  color: var(--text-body);
  font-size: 0.98rem;
  line-height: 1.9;
}

.about-card {
  padding: 26px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
}

.about-card h3 {
  margin: 0 0 12px;
  color: var(--text-heading);
  font-size: 1.2rem;
}

.about-card p {
  margin: 0;
  color: var(--text-body);
  font-size: 0.92rem;
  line-height: 1.85;
}

/* =====================================================
   5. SKILLS
===================================================== */

.skills-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  align-items: stretch;
}

.skill-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 25px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
}

.skill-card:hover {
  transform: translateY(-4px);
  border-color: var(--border-hover);
  background: var(--surface-hover);
}

.skill-index {
  display: block;
  margin-bottom: 13px;
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.1em;
}

.skill-card h3 {
  margin: 0 0 17px;
  color: var(--text-heading);
  font-family: var(--font-heading);
  font-size: 1.1rem;
  line-height: 1.4;
}

.skill-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 9px;
  width: 100%;
  margin-top: auto;
}

.skill-tags span {
  display: inline-flex;
  max-width: 100%;
  padding: 6px 10px;
  border: 1px solid rgba(208, 161, 109, 0.25);
  border-radius: 5px;
  background: rgba(166, 109, 69, 0.12);
  color: #E8D4BB;
  font-size: 0.78rem;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

/* =====================================================
   6. EDUCATION
===================================================== */

.education-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.education-card {
  padding: 25px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
}

.education-card h3 {
  margin: 0 0 8px;
  color: var(--text-heading);
  font-size: 1.15rem;
}

.education-card p {
  margin: 7px 0 0;
  color: var(--text-body);
  font-size: 0.9rem;
  line-height: 1.75;
}

.education-card .education-date {
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 0.75rem;
}

/* =====================================================
   7. EXPERIENCE AND LEADERSHIP
===================================================== */

.experience-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.experience-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  padding: 27px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
}

.experience-card:hover {
  transform: translateY(-4px);
  border-color: var(--border-hover);
  background: var(--surface-hover);
}

.experience-card .eyebrow {
  order: 1;
  margin-bottom: 10px;
  color: var(--accent);
}

.experience-number {
  order: 2;
  display: block;
  margin: 0 0 13px;
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 1.65rem;
  line-height: 1.2;
  letter-spacing: 0.04em;
}

.experience-card h3 {
  order: 3;
  margin: 0 0 6px;
  color: var(--text-heading);
  font-size: 1.2rem;
  line-height: 1.4;
}

.experience-card h4 {
  order: 4;
  margin: 0 0 14px;
  color: var(--accent);
  font-family: var(--font-body);
  font-size: 0.9rem;
  font-weight: 600;
}

.experience-card p {
  order: 5;
  margin: 0;
  color: var(--text-body);
  font-size: 0.92rem;
  line-height: 1.85;
}

.timeline {
  width: 100%;
  max-width: 100%;
}

/* =====================================================
   8. PROJECTS
===================================================== */

.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
  align-items: stretch;
}

.project-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 27px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  border-radius: 11px;
  box-shadow: none;
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease, background 0.3s ease;
}

.project-card:hover {
  transform: translateY(-5px);
  background: rgba(255, 255, 255, 0.045);
  border-color: var(--border-hover);
  box-shadow: 0 16px 38px rgba(12, 5, 5, 0.3);
}

.project-top {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10px 15px;
  margin-bottom: 22px;
}

.project-number {
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  letter-spacing: 0.08em;
}

.project-category {
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 0.65rem;
  line-height: 1.5;
  text-align: right;
}

.project-card h3 {
  margin: 0 0 12px;
  color: var(--text-heading);
  font-size: 1.35rem;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.project-card > p {
  margin: 0 0 20px;
  color: var(--text-body);
  font-size: 0.94rem;
  line-height: 1.85;
  overflow-wrap: anywhere;
}

.project-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 9px;
  margin: 0 0 23px;
}

.project-tags span {
  display: inline-flex;
  max-width: 100%;
  padding: 6px 10px;
  background: rgba(166, 109, 69, 0.12);
  border: 1px solid rgba(208, 161, 109, 0.24);
  border-radius: 5px;
  color: #E8D4BB;
  font-size: 0.75rem;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.project-links {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 13px 22px;
  margin-top: auto;
  padding-top: 5px;
}

.project-links a,
.project-details-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--accent);
  font-size: 0.85rem;
  font-weight: 700;
  transition: color 0.2s ease;
}

.project-links a:hover,
.project-details-link:hover {
  color: #F0D0A2;
}

/* =====================================================
   9. CERTIFICATES
===================================================== */

.certificates-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 22px;
  align-items: start;
}

.certificate-card {
  min-width: 0;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  border-radius: 9px;
  transition: transform 0.25s ease, border-color 0.25s ease;
}

.certificate-card:hover {
  transform: translateY(-3px);
  border-color: var(--border-hover);
}

.certificate-preview {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  aspect-ratio: 4 / 3;
  padding: 9px;
  overflow: hidden;
  background: rgba(73, 48, 39, 0.5);
  border: 0;
  cursor: zoom-in;
}

.certificate-preview img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform 0.3s ease;
}

.certificate-card:hover .certificate-preview img {
  transform: scale(1.035);
}

.certificate-pdf-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
  height: 100%;
  color: var(--accent);
  background: linear-gradient(145deg, #542B2D, #493027);
}

.certificate-pdf-preview span {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.1em;
}

.certificate-zoom {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: rgba(35, 18, 18, 0.72);
  color: var(--text-heading);
  font-size: 0.82rem;
  font-weight: 600;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.certificate-card:hover .certificate-zoom,
.certificate-preview:focus-visible .certificate-zoom {
  opacity: 1;
}

.certificate-info {
  padding: 12px 14px 15px;
}

.certificate-info h3 {
  margin: 0 0 6px;
  color: var(--text-heading);
  font-size: 0.92rem;
  line-height: 1.4;
}

.certificate-info p {
  margin: 3px 0;
  color: var(--text-muted);
  font-size: 0.76rem;
  line-height: 1.55;
}

.empty-state {
  padding: 28px;
  border: 1px dashed var(--border);
  border-radius: 10px;
  background: var(--surface);
}

.empty-state p {
  margin: 10px 0 0;
}

/* =====================================================
   10. ACHIEVEMENTS
===================================================== */

.achievements-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.achievement-card {
  padding: 22px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 9px;
}

.achievement-card h3 {
  margin: 0 0 8px;
  color: var(--text-heading);
  font-family: var(--font-body);
  font-size: 1rem;
}

.achievement-card p {
  margin: 0;
  color: var(--text-body);
  font-size: 0.9rem;
  line-height: 1.8;
}

/* =====================================================
   11. CONTACT
===================================================== */

.contact-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.contact-card {
  display: flex;
  align-items: center;
  gap: 15px;
  min-width: 0;
  padding: 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 9px;
  transition: transform 0.25s ease, border-color 0.25s ease;
}

.contact-card:hover {
  transform: translateY(-3px);
  border-color: var(--border-hover);
}

.contact-card h3 {
  margin: 0 0 4px;
  color: var(--text-heading);
  font-family: var(--font-body);
  font-size: 0.95rem;
}

.contact-card p,
.contact-card a {
  margin: 0;
  color: var(--text-body);
  font-size: 0.85rem;
  overflow-wrap: anywhere;
}

.contact-card a:hover {
  color: var(--accent);
}

/* =====================================================
   12. FOOTER
===================================================== */

.footer {
  padding: 30px 0;
  background: rgba(25, 14, 14, 0.65);
  border-top: 1px solid var(--border);
  color: var(--text-body);
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.footer p {
  margin: 0;
  color: var(--text-muted);
  font-size: 0.82rem;
}

.footer a {
  color: var(--text-body);
  font-size: 0.85rem;
}

.footer a:hover {
  color: var(--accent);
}

/* =====================================================
   13. TABLET
===================================================== */

@media (max-width: 900px) {
  .hero {
    min-height: auto;
    padding: 65px 0 80px;
  }

  .hero-content {
    grid-template-columns: minmax(0, 1fr) minmax(250px, 0.85fr);
    gap: 28px;
  }

  .hero h1 {
    font-size: clamp(3.2rem, 7vw, 4.5rem);
  }

  .hero-portrait-wrap {
    width: clamp(250px, 36vw, 340px);
  }

  .skills-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .certificates-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .nav-links {
    gap: 12px;
  }

  .nav-links a {
    font-size: 0.75rem;
  }
}

/* =====================================================
   14. MOBILE
===================================================== */

@media (max-width: 680px) {
  .navbar-inner {
    position: relative;
    min-height: 68px;
  }

  .navbar-logo {
    font-size: 1.05rem;
  }

  .mobile-menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .nav-links {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: none;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 10px 18px 16px;
    background: #321C1D;
    border: 1px solid var(--border);
    border-top: 0;
    border-radius: 0 0 9px 9px;
  }

  .nav-links.nav-open {
    display: flex;
  }

  .nav-links a {
    padding: 11px 5px;
    font-size: 0.9rem;
  }

  .nav-links .nav-contact {
    align-self: flex-start;
    margin-top: 8px;
    padding: 8px 13px;
  }

  .hero {
    min-height: auto;
    padding: 48px 0 65px;
  }

  .hero-content {
    grid-template-columns: minmax(0, 1fr);
    gap: 38px;
  }

  .hero-text {
    max-width: 100%;
  }

  .hero-eyebrow {
    margin-bottom: 18px;
    font-size: 0.65rem;
  }

  .hero-greeting {
    font-size: 0.9rem;
  }

  .hero h1 {
    font-size: clamp(3.3rem, 13vw, 4.7rem);
    line-height: 1.04;
  }

  .hero h2 {
    margin-top: 18px;
    font-size: 1rem;
  }

  .hero-description {
    margin-top: 15px;
    font-size: 0.92rem;
    line-height: 1.8;
  }

  .hero-actions {
    gap: 10px;
    margin-top: 23px;
  }

  .hero-socials {
    gap: 15px;
    margin-top: 23px;
  }

  .hero-visual {
    justify-content: center;
  }

  .hero-portrait-wrap {
    width: min(84vw, 340px);
  }

  .hero-scroll {
    display: none;
  }

  .about-grid,
  .experience-grid,
  .projects-grid,
  .contact-grid,
  .education-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .skills-grid,
  .achievements-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .certificates-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .section {
    padding-block: 48px;
  }

  .section-heading {
    margin-bottom: 25px;
  }

  .footer-inner {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* =====================================================
   15. SMALL MOBILE
===================================================== */

@media (max-width: 420px) {
  .hero {
    padding-top: 40px;
  }

  .hero h1 {
    font-size: clamp(2.9rem, 14vw, 3.8rem);
  }

  .hero-actions {
    align-items: stretch;
  }

  .hero-actions a {
    flex: 1 1 auto;
  }

  .hero-portrait-wrap {
    width: min(82vw, 300px);
  }

  .skills-grid,
  .achievements-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .certificates-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .about-card,
  .skill-card,
  .experience-card,
  .project-card,
  .education-card {
    padding: 20px;
  }

  .section-heading h2,
  .section-title {
    font-size: 2rem;
  }

  .project-top {
    align-items: flex-start;
  }

  .project-category {
    max-width: 70%;
  }
}

/* =====================================================
   16. ACCESSIBILITY
===================================================== */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}

/* =====================================================
   17. CERTIFICATE LIGHTBOX
===================================================== */

.certificate-lightbox {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(12, 7, 7, 0.9);
  backdrop-filter: blur(9px);
}

.certificate-modal {
  display: flex;
  flex-direction: column;
  width: min(100%, 1050px);
  height: min(90vh, 850px);
  overflow: hidden;
  background: #321C1D;
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);
}

.certificate-modal-header {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 14px 20px;
  color: var(--text-heading);
  border-bottom: 1px solid var(--border);
  font-size: 0.9rem;
  font-weight: 600;
}

.certificate-modal-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}

.certificate-modal-actions button,
.certificate-modal-actions a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 5px;
  background: transparent;
  border: 0;
  color: var(--text-heading);
  cursor: pointer;
}

.certificate-modal-actions button:hover,
.certificate-modal-actions a:hover {
  color: var(--accent);
}

.certificate-modal-content {
  display: flex;
  flex: 1;
  min-height: 0;
  align-items: center;
  justify-content: center;
  padding: 18px;
  overflow: auto;
  background: #211719;
}

.certificate-modal-content img {
  display: block;
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  object-fit: contain;
}

.certificate-modal-content iframe {
  width: 100%;
  height: 100%;
  min-height: 500px;
  border: 0;
  background: white;
}

@media (max-width: 680px) {
  .certificate-lightbox {
    padding: 10px;
  }

  .certificate-modal {
    height: 92vh;
  }

  .certificate-modal-content {
    padding: 8px;
  }

  .certificate-modal-content iframe {
    min-height: 400px;
  }
}
